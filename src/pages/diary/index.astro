---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PostCard } from '../../components/PostCard';
const posts = (await getCollection('diary', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const site = Astro.site ?? new URL('https://neu-dev.net');
const pageUrl = new URL('/diary/', site).href;
const description = '身近な疑問をデータや計算で掘り下げた分析と、NeUの日々の出来事や発見をまとめた日記・分析記事の一覧。';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      url: pageUrl,
      name: 'NeULOG 日記・分析記事一覧',
      description,
      inLanguage: 'ja',
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: posts.map((post, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: post.data.title,
          url: new URL(`/diary/${post.data.permalink || post.slug}/`, site).href,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', site).href },
        { '@type': 'ListItem', position: 2, name: '日記・分析記事', item: pageUrl },
      ],
    },
  ],
};
---
<BaseLayout title="日記・分析記事一覧" currentPage="diary" description={description} structuredData={structuredData}>
  <section class="page-head container">
    <p class="eyebrow">Archive / Diary · {String(posts.length).padStart(2, '0')}</p>
    <h1>日々の<mark>寄り道</mark></h1>
    <p>日々の出来事と、何気ない発見。気になったことは、データや計算でちょっと掘り下げてみます。</p>
    <nav class="filters" aria-label="記事の種類"><a href="/">すべて</a><a href="/tech/">技術</a><a class="is-active" aria-current="page" href="/diary/">日記 <sup>{posts.length}</sup></a></nav>
  </section>
  <section class="section section--tight container">
    <div class="post-grid">{posts.map((post, index) => <div class:list={['post-slot', { 'post-slot--featured': index === 0 }]} data-reveal style={`--rv-i:${index === 0 ? 0 : index % 3};--rv-r:${index % 2 ? 2 : -2}deg`}><PostCard client:visible title={post.data.title} excerpt={post.data.description || (post.data.mood ? `今日の気分: ${post.data.mood}` : '')} date={post.data.pubDate.toLocaleDateString('ja-JP')} category="diary" slug={post.data.permalink || post.slug} reactionSlug={post.slug} collection="diary" coverImage={post.data.coverImage} index={index} featured={index === 0} /></div>)}</div>
  </section>
</BaseLayout>
