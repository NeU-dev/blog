---
import { Header } from '../components/Header';
import { Footer } from '../components/Footer';
import { GameLauncher } from '../components/GameLauncher';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPage?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: Record<string, unknown>;
  noIndex?: boolean;
}

const {
  title,
  description,
  currentPage = 'home',
  canonical,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  structuredData,
  noIndex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://neu-dev.net');
const pageTitle = `${title} | NeULOG`;
const pageDescription = description?.trim() || 'アプリやWebサービスの企画・設計・運営に取り組むNeUのブログ。プロダクトづくりの中で考えたことや判断したこと、AIの活用について書いています。';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image ?? '/images/og/neulog-home.png', site).href;
const isDefaultImage = new URL(imageUrl).pathname === '/images/og/neulog-home.png';
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : undefined;
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content="NeU" />
    <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="NeULOG RSS" href={new URL('/rss.xml', site).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800;900&family=Geist+Mono:wght@400;500;600&family=Noto+Sans+JP:wght@400;500;700;800;900&family=Press+Start+2P&family=DotGothic16&display=swap" />
    <meta name="theme-color" content="#f1f3f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1c20" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const savedTheme = localStorage.getItem('neulog-theme');
          if (savedTheme === 'light' || savedTheme === 'dark') root.dataset.theme = savedTheme;
        } catch {}
        // Scroll-reveal hides content until the effects script runs; never leave it hidden.
        root.classList.add('fx');
        setTimeout(() => { if (!root.dataset.fxReady) root.classList.remove('fx'); }, 3000);
      })();
    </script>
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="NeULOG" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title} />
    {isDefaultImage && <meta property="og:image:width" content="1200" />}
    {isDefaultImage && <meta property="og:image:height" content="630" />}
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={title} />
    <title>{pageTitle}</title>
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson}></script>}

    <!-- Google Analytics -->
    {import.meta.env.PROD && <script async src="https://www.googletagmanager.com/gtag/js?id=G-96MQWWQ70F"></script>}
    {import.meta.env.PROD && <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-96MQWWQ70F');
    </script>}
  </head>
  <body id="top">
    <a href="#main-content" class="skip-link">本文へ移動</a>
    <Header currentPage={currentPage} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <GameLauncher client:load showButton={false} />
    <script>
      import { initFx } from '../lib/fx';
      document.documentElement.dataset.fxReady = '1';
      initFx();

      document.querySelectorAll('[data-open-game]').forEach(button => {
        button.addEventListener('click', () => window.dispatchEvent(new Event('open-neulog-game')));
      });
      const quests = ['今日は知らないAPIを1つ触る。', '失敗したコードを1つメモに残す。', '眠っているアイデアを10分だけ動くものにする。', 'READMEを未来の自分向けに1行直す。'];
      document.querySelector('[data-side-quest]')?.addEventListener('click', () => {
        const target = document.querySelector('[data-side-quest-message]');
        if (target) target.textContent = `今日のおまけ：${quests[Math.floor(Math.random() * quests.length)]}`;
      });

      const root = document.documentElement;
      const prefersDark = matchMedia('(prefers-color-scheme: dark)');
      document.querySelectorAll('[data-theme-toggle]').forEach(button => {
        button.addEventListener('click', () => {
          const current = root.dataset.theme ?? (prefersDark.matches ? 'dark' : 'light');
          const next = current === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('neulog-theme', next); } catch {}
        });
      });

      const header = document.querySelector('.site-header');
      const markScrolled = () => header?.classList.toggle('is-scrolled', scrollY > 8);
      markScrolled();
      addEventListener('scroll', markScrolled, { passive: true });
    </script>
  </body>
</html>
