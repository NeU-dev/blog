---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
const posts = (await getCollection('diary', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const site = Astro.site ?? new URL('https://neu-dev.net');
const pageUrl = new URL('/diary/', site).href;
const description = '身近な疑問をデータや計算で掘り下げた分析と、NeUの日々の出来事や発見をまとめた日記・分析記事の一覧。';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      url: pageUrl,
      name: 'NeULOG 日記・分析記事一覧',
      description,
      inLanguage: 'ja',
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: posts.map((post, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: post.data.title,
          url: new URL(`/diary/${post.data.permalink || post.slug}/`, site).href,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', site).href },
        { '@type': 'ListItem', position: 2, name: '日記・分析記事', item: pageUrl },
      ],
    },
  ],
};
---
<BaseLayout title="日記・分析記事一覧" currentPage="diary" description={description} structuredData={structuredData}>
  <section class="paper">
    <div class="page-head container">
      <h1>日々の寄り道</h1>
      <p>日々の出来事と、何気ない発見。気になったことは、データや計算でちょっと掘り下げてみます。</p>
      <nav class="filters" aria-label="記事の種類"><a href="/">すべて</a><a href="/tech/">技術</a><a class="is-active" aria-current="page" href="/diary/">日記</a></nav>
    </div>
  </section>
  <section class="section section--tight container">
    <PostList ruled headingLevel={2} posts={posts.map(post => ({ title: post.data.title, category: 'diary' as const, href: `/diary/${post.data.permalink || post.slug}/`, description: post.data.description || (post.data.mood ? `今日の気分: ${post.data.mood}` : ''), coverImage: post.data.coverImage, pubDate: post.data.pubDate }))} />
  </section>
</BaseLayout>
