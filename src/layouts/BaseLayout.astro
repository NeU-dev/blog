---
import { Header } from '../components/Header';
import { Footer } from '../components/Footer';
import { GameLauncher } from '../components/GameLauncher';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPage?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: Record<string, unknown>;
  noIndex?: boolean;
}

const {
  title,
  description,
  currentPage = 'home',
  canonical,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  structuredData,
  noIndex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://neu-dev.net');
const pageTitle = `${title} | NeULOG`;
const pageDescription = description?.trim() || 'アプリやWebサービスの企画・設計・運営に取り組むNeUのブログ。プロダクトづくりの中で考えたことや判断したこと、AIの活用について書いています。';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image ?? '/images/og/neulog-home.png', site).href;
const isDefaultImage = new URL(imageUrl).pathname === '/images/og/neulog-home.png';
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : undefined;
// 先読みは文書を取りに行くだけにする。先に描画まで進めると、読まれていない記事に訪問の記録が付くため。
const speculationRules = JSON.stringify({
  prefetch: [{ where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/rss.xml' } }] }, eagerness: 'moderate' }],
});
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content="NeU" />
    <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="NeULOG RSS" href={new URL('/rss.xml', site).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400;500;600;700&family=Klee+One:wght@600&family=Press+Start+2P&family=DotGothic16&display=swap" />
    <meta name="theme-color" content="#f7f9fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111722" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const savedTheme = localStorage.getItem('neulog-theme');
          if (savedTheme === 'light' || savedTheme === 'dark') root.dataset.theme = savedTheme;
        } catch {}
        // 動きは「動きを減らす」設定がオフのときだけ。スクリプトが動かなかったときに隠したままにしない。
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('motion');
          setTimeout(() => { if (!root.dataset.motionReady) root.classList.remove('motion'); }, 3000);
        }
        addEventListener('pagereveal', event => {
          if (!event.viewTransition) return;
          // ページ移動のアニメーションで着いたときは、飛んできた題名と画像を隠さない
          root.classList.add('vt-arrived');
          // 戻るとき（履歴を戻る、浅い階層へ移る）は、ページを逆向きにめくる
          const activation = window.navigation?.activation;
          const from = activation?.from;
          const to = activation?.entry;
          if (!from?.url || !to?.url) return;
          const depth = url => new URL(url).pathname.split('/').filter(Boolean).length;
          const back = activation.navigationType === 'traverse' ? to.index < from.index : depth(to.url) < depth(from.url);
          if (back) event.viewTransition.types?.add('back');
        });
      })();
    </script>
    <!-- リンクに触れたら、移動先のページを先に取りに行く（対応ブラウザのみ） -->
    <script type="speculationrules" is:inline set:html={speculationRules}></script>
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="NeULOG" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title} />
    {isDefaultImage && <meta property="og:image:width" content="1200" />}
    {isDefaultImage && <meta property="og:image:height" content="630" />}
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={title} />
    <title>{pageTitle}</title>
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson}></script>}

    <!-- Google Analytics -->
    {import.meta.env.PROD && <script async src="https://www.googletagmanager.com/gtag/js?id=G-96MQWWQ70F"></script>}
    {import.meta.env.PROD && <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-96MQWWQ70F');
    </script>}
  </head>
  <body id="top">
    <a href="#main-content" class="skip-link">本文へ移動</a>
    <Header currentPage={currentPage} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <GameLauncher client:load showButton={false} />
    <script>
      import { initReadProgress } from '../lib/read-progress';
      import { initMotion } from '../lib/motion';
      import { initCursor } from '../lib/cursor';
      initReadProgress();
      initMotion();
      initCursor();

      document.querySelectorAll('[data-open-game]').forEach(button => {
        button.addEventListener('click', () => window.dispatchEvent(new Event('open-neulog-game')));
      });
      const root = document.documentElement;
      const prefersDark = matchMedia('(prefers-color-scheme: dark)');
      document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach(button => {
        button.addEventListener('click', () => {
          const current = root.dataset.theme ?? (prefersDark.matches ? 'dark' : 'light');
          const next = current === 'dark' ? 'light' : 'dark';
          const apply = () => {
            root.dataset.theme = next;
            try { localStorage.setItem('neulog-theme', next); } catch {}
          };
          if (!document.startViewTransition || !root.classList.contains('motion')) { apply(); return; }
          // 押したボタンから円が広がって、新しい色に塗り替わる
          const box = button.getBoundingClientRect();
          const x = box.left + box.width / 2;
          const y = box.top + box.height / 2;
          const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
          root.classList.add('theme-vt');
          const transition = document.startViewTransition(apply);
          transition.ready.then(() => {
            root.animate(
              { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
              { duration: 800, easing: 'cubic-bezier(.65, 0, .35, 1)', pseudoElement: '::view-transition-new(root)' },
            );
          });
          transition.finished.finally(() => root.classList.remove('theme-vt'));
        });
      });
    </script>
  </body>
</html>
