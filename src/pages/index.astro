---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PostList, { type PostEntry } from '../components/PostList.astro';
import { Leaderboard } from '../components/Leaderboard';
import { VisitorTicket } from '../components/VisitorTicket';
import { Portfolio } from '../components/Portfolio';
import { getNoteArticles, NOTE_PROFILE_URL } from '../lib/note-feed';

const techPosts = await getCollection('tech', ({ data }) => !data.draft);
const diaryPosts = await getCollection('diary', ({ data }) => !data.draft);
const notePosts = await getNoteArticles(6);
const allPosts: PostEntry[] = [
  ...techPosts.map(post => ({ title: post.data.title, category: 'tech' as const, href: `/tech/${post.slug}/`, description: post.data.description || '', coverImage: post.data.coverImage, pubDate: post.data.pubDate })),
  ...diaryPosts.map(post => ({ title: post.data.title, category: 'diary' as const, href: `/diary/${post.data.permalink || post.slug}/`, description: post.data.description || (post.data.mood ? `今日の気分: ${post.data.mood}` : ''), coverImage: post.data.coverImage, pubDate: post.data.pubDate })),
  ...notePosts.map(post => ({ title: post.title, category: 'note' as const, href: post.url, description: post.description, coverImage: post.coverImage, pubDate: post.pubDate, external: true })),
].sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());
const titleLines = ['つくりながら', '考えたことの記録。'];

const site = Astro.site ?? new URL('https://neu-dev.net');
const homeDescription = 'アプリやWebサービスの企画・設計・運営に取り組むNeUのブログ。プロダクトづくりの中で考えたことや判断したこと、AIの活用について書いています。';
const homeStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', site).href,
      url: new URL('/', site).href,
      name: 'NeULOG',
      alternateName: 'NeU.dev',
      description: homeDescription,
      inLanguage: 'ja',
      publisher: { '@id': new URL('/#person', site).href },
    },
    {
      '@type': 'Person',
      '@id': new URL('/#person', site).href,
      name: 'NeU',
      url: new URL('/about/', site).href,
      knowsAbout: ['プロダクト企画', '課題整理', '機能・体験設計', 'AIの活用', 'サービス運営', '改善・検証'],
    },
  ],
};
---

<BaseLayout
  title="プロダクトづくり・AI活用のブログ"
  currentPage="home"
  description={homeDescription}
  image="/images/og/neulog-home.png"
  structuredData={homeStructuredData}
>
  <section class="hero paper" aria-label="NeUのブログ紹介">
    <div class="container hero__inner">
      <div class="hero__copy">
        <h1 class="hero__title">{titleLines.map((line, i) => <span class="hero__line" style={`--i:${i}`}><span class="ink-line">{line}</span></span>)}</h1>
        <p class="hero__lead">アプリやWebサービスの企画・設計・運営をしているNeUのブログです。プロダクトづくりで判断したことや、AIの使い方について書いています。</p>
        <div class="hero__links">
          <a href="/about/" class="hero__author text-link"><img src="/icon.JPG" alt="" width="72" height="72" />書いている人</a>
          <a href="#portfolio" class="text-link">つくったアプリ</a>
        </div>
      </div>
      <div class="hero-play" data-hero-play>
        <button type="button" class="hero-play__screen" data-open-game aria-label="ブロック崩しで遊ぶ（画面は自動プレイのデモ）">
          <canvas width="768" height="440" aria-hidden="true"></canvas>
        </button>
        <p class="hero-play__hint"><span class="hero-play__hint-mouse">カーソルを乗せるとパドルを動かせます。クリックで本番のゲームへ。</span><span class="hero-play__hint-touch">タップすると本番のゲームが始まります。</span></p>
      </div>
    </div>
  </section>

  <section id="latest" class="section section--tight container" aria-labelledby="latest-title">
    <header class="section-head">
      <h2 id="latest-title" class="section-title">最近の記事</h2>
      <nav class="filters" aria-label="記事の種類">
        <a class="is-active" aria-current="page" href="/">すべて</a><a href="/tech/">技術</a><a href="/diary/">日記</a>{notePosts.length > 0 && <a href={NOTE_PROFILE_URL} target="_blank" rel="noopener noreferrer">note ↗</a>}
      </nav>
    </header>
    <PostList posts={allPosts} />
    {allPosts.length === 0 && <div class="empty-state"><b>まだ記事がありません</b><span>最初の記事を準備中です。</span></div>}
  </section>

  <Portfolio className="container" />

  <section class="section container" aria-labelledby="playground-title">
    <div class="playground__box">
      <div>
        <h2 id="playground-title" class="playground__title">考える合間に、<wbr />ひとゲーム。</h2>
        <p class="playground__lead">1面だけのブロック崩しです。スコアはとなりのランキングに載ります。</p>
        <button type="button" class="btn" data-open-game data-cursor="遊ぶ">ブロック崩しを始める</button>
        <VisitorTicket client:visible />
      </div>
      <Leaderboard client:visible />
    </div>
  </section>
</BaseLayout>

<script>
  import { mountHeroBreakout } from '../lib/hero-breakout';
  const play = document.querySelector<HTMLElement>('[data-hero-play]');
  if (play) mountHeroBreakout(play);
</script>
