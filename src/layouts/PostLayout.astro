---
import BaseLayout from './BaseLayout.astro';
import { PostHeader } from '../components/PostHeader';
import { PostFooter } from '../components/PostFooter';
import { ArticleReactions } from '../components/ArticleReactions';
import { postTransitionName } from '../lib/view-transition';
import { hasOwnToc, tocItems } from '../lib/toc';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags?: string[];
  coverImage?: string;
  slug: string;
  reactionSlug?: string;
  // 目次をつくるための、本文の見出しと元の文章
  headings?: { depth: number; slug: string; text: string }[];
  body?: string;
}

const { title, description, pubDate, updatedDate, category, tags = [], coverImage, slug, reactionSlug = slug, headings = [], body } = Astro.props;
const toc = tocItems(headings, body);
const showTocFold = toc.length > 0 && !hasOwnToc(headings);

const site = Astro.site ?? new URL('https://neu-dev.net');
const canonicalUrl = new URL(`/${category}/${slug}/`, site).href;
const imageUrl = coverImage ? new URL(coverImage, site).href : undefined;
const categoryName = category === 'tech' ? '技術記事' : '日記';
const transitionName = postTransitionName(`/${category}/${slug}/`);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: title,
      description,
      ...(imageUrl ? { image: [imageUrl] } : {}),
      datePublished: pubDate.toISOString(),
      dateModified: (updatedDate ?? pubDate).toISOString(),
      mainEntityOfPage: canonicalUrl,
      url: canonicalUrl,
      inLanguage: 'ja',
      author: {
        '@type': 'Person',
        name: 'NeU',
        url: new URL('/about/', site).href,
      },
      publisher: {
        '@type': 'Person',
        name: 'NeU',
        url: new URL('/', site).href,
      },
      isPartOf: {
        '@type': 'Blog',
        name: 'NeULOG',
        url: new URL('/', site).href,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'ホーム',
          item: new URL('/', site).href,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: categoryName,
          item: new URL(`/${category}/`, site).href,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: title,
          item: canonicalUrl,
        },
      ],
    },
  ],
};

const formattedDate = pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={title}
  description={description}
  currentPage={category}
  canonical={canonicalUrl}
  image={imageUrl}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={(updatedDate ?? pubDate).toISOString()}
  structuredData={structuredData}
>
  <div class="read-progress" aria-hidden="true"><i></i></div>
  <div class="post-page">
    <div class="paper">
      <PostHeader
        client:load
        title={title}
        category={category}
        date={formattedDate}
        tags={tags}
        slug={reactionSlug}
        coverImage={coverImage}
        transitionName={transitionName}
      />
    </div>

    <div class="article-layout">
      <div class="article-shell container">
        {showTocFold && (
          <details class="toc-fold">
            <summary>目次</summary>
            <ol>
              {toc.map(item => <li><a href={`#${item.slug}`}>{item.text}</a></li>)}
            </ol>
          </details>
        )}
        <article class="article-body" data-article-slug={`${category}/${reactionSlug}`}>
          <slot />
        </article>
        <ArticleReactions client:visible slug={`${category}/${reactionSlug}`} />
        <PostFooter client:load />
      </div>
      {toc.length > 0 && (
        <nav class="toc-rail" aria-label="目次">
          <p class="toc-rail__title">目次</p>
          <ol>
            {toc.map(item => <li><a href={`#${item.slug}`}>{item.text}</a></li>)}
          </ol>
        </nav>
      )}
    </div>
  </div>

  <script>
    import { initArticlePolls } from '../lib/article-polls';
    import { communityApi } from '../lib/community';
    import { initToc } from '../lib/toc';

    initToc();
    const article = document.querySelector<HTMLElement>('.article-body[data-article-slug]');
    if (article) {
      initArticlePolls(article);
      // ミッション・ファインダーは、置かれている記事でだけ読み込む
      const missionFinder = article.querySelector<HTMLElement>('.mission-finder');
      if (missionFinder) {
        import('../lib/mission-finder/app.js')
          .then(({ mountMissionFinder }) => mountMissionFinder(missionFinder))
          .catch(error => console.error('mission_finder_failed', error));
      }
      const articleSlug = article.dataset.articleSlug;
      if (articleSlug) {
        communityApi('visit', { method: 'POST', body: { slug: articleSlug } }).catch(() => undefined);
      }
    }
  </script>

  <!-- Mermaid対応 -->
  <script type="module">
    const mermaidBlocks = document.querySelectorAll('pre[data-language="mermaid"]');
    if (mermaidBlocks.length) {
      const mermaidModuleUrl = 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
      const { default: mermaid } = await import(/* @vite-ignore */ mermaidModuleUrl);
      mermaid.initialize({
        startOnLoad: false,
        theme: 'base',
        themeVariables: {
          fontFamily: '"IBM Plex Sans JP", sans-serif',
          primaryColor: '#dbe4ff',
          primaryTextColor: '#1a2332',
          primaryBorderColor: '#2443c4',
          lineColor: '#3e4a5c',
          secondaryColor: '#edf1f6',
          tertiaryColor: '#ffffff'
        }
      });

      mermaidBlocks.forEach((pre) => {
        const code = pre.textContent;
        const div = document.createElement('div');
        div.className = 'mermaid';
        div.textContent = code;
        pre.parentNode?.replaceChild(div, pre);
      });

      await mermaid.run();
    }
  </script>
</BaseLayout>
