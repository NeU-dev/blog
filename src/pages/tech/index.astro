---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
const posts = (await getCollection('tech', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const site = Astro.site ?? new URL('https://neu-dev.net');
const pageUrl = new URL('/tech/', site).href;
const description = 'iOS・SwiftUI、生成AI、Astro、Electronなど、NeUの個人開発で試した実装・失敗・学びをまとめた技術記事一覧。';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      url: pageUrl,
      name: 'NeULOG 技術記事一覧',
      description,
      inLanguage: 'ja',
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: posts.map((post, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: post.data.title,
          url: new URL(`/tech/${post.slug}/`, site).href,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', site).href },
        { '@type': 'ListItem', position: 2, name: '技術記事', item: pageUrl },
      ],
    },
  ],
};
---
<BaseLayout title="技術記事一覧" currentPage="tech" description={description} structuredData={structuredData}>
  <section class="paper">
    <div class="page-head container">
      <h1>技術の実験ログ</h1>
      <p>つくって、壊して、理解したこと。iOS・生成AI・Webの個人開発で試したことをまとめています。</p>
      <nav class="filters" aria-label="記事の種類"><a href="/">すべて</a><a class="is-active" aria-current="page" href="/tech/">技術</a><a href="/diary/">日記</a></nav>
    </div>
  </section>
  <section class="section section--tight container">
    <PostList ruled headingLevel={2} posts={posts.map(post => ({ title: post.data.title, category: 'tech' as const, href: `/tech/${post.slug}/`, description: post.data.description, coverImage: post.data.coverImage, pubDate: post.data.pubDate }))} />
  </section>
</BaseLayout>
