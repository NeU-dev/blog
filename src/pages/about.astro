---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AboutView } from '../components/AboutView';
import ClaudeWork from '../components/ClaudeWork.astro';

const site = Astro.site ?? new URL('https://neu-dev.net');
const pageUrl = new URL('/about/', site).href;
const description = '愛知で、Claude Codeと一緒にアプリやWebサービスをつくって運営しているNeUのプロフィール。公開しているアプリと、Claude Codeでのつくり方の記事をまとめています。';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${pageUrl}#profile`,
      url: pageUrl,
      name: 'NeUのプロフィール',
      description,
      inLanguage: 'ja',
      mainEntity: { '@id': new URL('/#person', site).href },
    },
    {
      '@type': 'Person',
      '@id': new URL('/#person', site).href,
      name: 'NeU',
      url: pageUrl,
      knowsAbout: ['プロダクト企画', '課題整理', '機能・体験設計', 'Claude Code', 'AIの活用', 'サービス運営', '改善・検証'],
    },
  ],
};
---

<BaseLayout title="NeUのプロフィール" currentPage="about" description={description} structuredData={structuredData}>
  <AboutView><ClaudeWork /></AboutView>
</BaseLayout>
