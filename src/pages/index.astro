---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PostCard } from '../components/PostCard';
import { HeroConsole } from '../components/HeroConsole';
import { Leaderboard } from '../components/Leaderboard';
import { VisitorTicket } from '../components/VisitorTicket';
import { getNoteArticles, NOTE_PROFILE_URL } from '../lib/note-feed';

const techPosts = await getCollection('tech', ({ data }) => !data.draft);
const diaryPosts = await getCollection('diary', ({ data }) => !data.draft);
const notePosts = await getNoteArticles(6);
const allPosts = [
  ...techPosts.map(post => ({ title: post.data.title, category: 'tech' as const, publicSlug: post.slug, reactionSlug: post.slug, description: post.data.description || '', coverImage: post.data.coverImage, pubDate: post.data.pubDate })),
  ...diaryPosts.map(post => ({ title: post.data.title, category: 'diary' as const, publicSlug: post.data.permalink || post.slug, reactionSlug: post.slug, description: post.data.description || (post.data.mood ? `今日の気分: ${post.data.mood}` : ''), coverImage: post.data.coverImage, pubDate: post.data.pubDate })),
  ...notePosts.map(post => ({ title: post.title, category: 'note' as const, publicSlug: post.url, reactionSlug: undefined, description: post.description, coverImage: post.coverImage, pubDate: post.pubDate, externalUrl: post.url })),
].sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

const site = Astro.site ?? new URL('https://neu-dev.net');
const homeDescription = 'iOSアプリやWebツールを個人開発。生成AIを相棒にした開発の試行錯誤と、身近な疑問をデータや計算で掘り下げた記録を書くNeUのブログ。';
const homeStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', site).href,
      url: new URL('/', site).href,
      name: 'NeULOG',
      alternateName: 'NeU.dev',
      description: homeDescription,
      inLanguage: 'ja',
      publisher: { '@id': new URL('/#person', site).href },
    },
    {
      '@type': 'Person',
      '@id': new URL('/#person', site).href,
      name: 'NeU',
      url: new URL('/about/', site).href,
      jobTitle: '個人開発者',
      knowsAbout: ['iOS', 'SwiftUI', '生成AI', 'Astro', 'Electron', 'データ分析'],
    },
  ],
};
---

<BaseLayout
  title="iOSアプリ・生成AIの個人開発ブログ"
  currentPage="home"
  description={homeDescription}
  image="/images/og/neulog-home.png"
  structuredData={homeStructuredData}
>
  <section class="home-hero" aria-label="NeUの個人開発と寄り道の記録">
    <div class="home-hero__inner">
      <div class="hero-copy">
        <div class="status-ribbon"><i aria-hidden="true"></i> NEU'S FIELD NOTES</div>
        <h1>つくりかけも、<br /><em>おもしろい。</em></h1>
        <p>iOSアプリも、Webも、身近な「なんで？」も。<br />生成AIを相棒に、つくって考えたことを残す場所。</p>
        <div class="hero-actions">
          <a href="#latest" class="pixel-button pixel-button--purple hero-latest">最新の記事を読む <span aria-hidden="true">↘</span></a>
          <span class="hero-byline">WRITTEN BY NeU</span>
        </div>
        <div class="hero-topics" aria-label="いまの領域"><span>iOS / SwiftUI</span><span>生成AI</span><span>Web / Electron</span><span>データ分析</span></div>
      </div>
      <div class="hero-console-stack">
        <HeroConsole client:visible />
        <button type="button" class="pixel-button game-launcher-button" data-open-game><span class="game-launcher-icon" aria-hidden="true">▶</span><span>ブロック崩しで遊ぶ</span><span aria-hidden="true">↗</span></button>
      </div>
    </div>
  </section>

  <section id="latest" class="logs-section">
    <div class="logs-heading">
      <div class="section-kicker"><h2>最近のログ</h2><span>LATEST NOTES / {String(allPosts.length).padStart(2, '0')}</span></div>
      <nav class="log-filters" aria-label="記事の種類">
        <a class="is-active" aria-current="page" href="/">すべて</a><a href="/tech/">技術</a><a href="/diary/">日記</a>{notePosts.length > 0 && <a class="log-note-link" href={NOTE_PROFILE_URL} target="_blank" rel="noopener noreferrer">note ↗</a>}
      </nav>
    </div>
    <div class="logs-grid">
      {allPosts.map((post, index) => (
        <PostCard client:visible title={post.title} excerpt={post.description} date={post.pubDate.toLocaleDateString('ja-JP')} category={post.category} slug={post.publicSlug} reactionSlug={post.reactionSlug} collection={post.category} coverImage={post.coverImage} externalUrl={post.externalUrl} index={index} featured={index === 0 && post.category !== 'note'} />
      ))}
    </div>
    {allPosts.length === 0 && <div class="empty-state"><b>まだ記事がありません</b><span>最初の記事を準備中です。</span></div>}
  </section>

  <section class="arcade-strip" aria-label="ブロック崩し">
    <span class="arcade-symbol" aria-hidden="true">✳</span>
    <div><span class="eyebrow">A LITTLE BREAK</span><h2>考える合間に、ひとゲーム。</h2><p>ブロックを崩して、頭をちょっとほぐそう。</p></div>
    <button type="button" class="pixel-button" data-open-game>ブロック崩しで遊ぶ <span aria-hidden="true">↗</span></button>
  </section>
  <div class="home-visitor"><VisitorTicket client:visible /></div>
  <Leaderboard client:visible />
</BaseLayout>
