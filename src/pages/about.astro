---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AboutView } from '../components/AboutView';

const site = Astro.site ?? new URL('https://neu-dev.net');
const pageUrl = new URL('/about/', site).href;
const description = '個人でアプリやWebサービスの企画・設計・運営に取り組むNeUのプロフィール。ユーザーの課題を整理し、AIを活用しながら開発と改善を進めています。';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${pageUrl}#profile`,
      url: pageUrl,
      name: 'NeUのプロフィール',
      description,
      inLanguage: 'ja',
      mainEntity: { '@id': new URL('/#person', site).href },
    },
    {
      '@type': 'Person',
      '@id': new URL('/#person', site).href,
      name: 'NeU',
      url: pageUrl,
      knowsAbout: ['プロダクト企画', '課題整理', '機能・体験設計', 'AIの活用', 'サービス運営', '改善・検証'],
    },
  ],
};
---

<BaseLayout title="NeUのプロフィール" currentPage="about" description={description} structuredData={structuredData}>
  <AboutView client:load />
</BaseLayout>
